# Provider requirements. Runs unchanged under `tofu` or `terraform`.
# The provider CONFIG (with the token) is generated by Terragrunt at the root, so
# the same module works against a different Hetzner project per environment.

terraform {
  required_version = ">= 1.6"
  required_providers {
    hcloud = {
      source  = "hetznercloud/hcloud"
      version = "~> 1.48"
    }
  }
}
