# Copy to `secrets.auto.tfvars` (gitignored) and fill in, OR export the values as
# environment variables instead (nothing on disk):
#
#   export HCLOUD_TOKEN=...        # the hcloud provider reads this automatically
#   export TF_VAR_admin_allowed_ips='["203.0.113.4/32"]'
#
# The Hetzner token is PROJECT-SCOPED: generate it in the MaagapAruga project's
# console (Security -> API Tokens, Read & Write). Use a DIFFERENT project/token
# for staging vs production for full isolation.

# Hetzner Cloud API token for THIS environment's project. Prefer HCLOUD_TOKEN env.
hcloud_token = "REPLACE_WITH_PROJECT_SCOPED_HETZNER_TOKEN"

# Your admin source IP(s) — the ONLY addresses allowed to reach SSH (port 10022).
# CIDR notation. Find yours: `curl -s https://ifconfig.me`.
admin_allowed_ips = ["203.0.113.4/32"]

# Optional: IPs allowed to reach the k8s API (6443). Empty = closed (kubectl via
# SSH tunnel only, the default).
# k8s_api_allowed_ips = []

# Public SSH key that may log in as the admin user (the private half stays on
# your machine). Prefer the fingerprint of a key already uploaded to the project.
ssh_public_keys = ["ssh-ed25519 AAAA... you@host"]
