# ONE place for every token that Terragrunt/Terraform read from the environment.
# Copy to `env.sh` (gitignored), fill in, then before running terragrunt:
#
#   cd infra/terragrunt && source env.sh && cd production && terragrunt apply
#
# Reminder of what lives WHERE (this trips everyone up):
#   - Hetzner token .......... here (HCLOUD_TOKEN) OR in secrets.auto.tfvars
#   - B2 / DO S3 keys ........ here, mapped to AWS_* (the state backend is S3)
#   - admin IPs / SSH keys ... secrets.auto.tfvars  (they are Terraform *variables*)
#   - B2 / DO BACKUP keys .... NOT here — they become a k8s secret at deploy time

# --- Hetzner (compute) ------------------------------------------------------
# The Hetzner project's token (Security -> API Tokens, Read & Write). Project-scoped.
export HCLOUD_TOKEN="REPLACE_WITH_HETZNER_TOKEN"

# --- Terraform remote state on Backblaze B2 (S3-compatible) -----------------
# Map the B2 APPLICATION KEY onto the AWS S3 env vars the backend expects:
export AWS_ACCESS_KEY_ID="REPLACE_WITH_B2_APPLICATION_KEY_ID"
export AWS_SECRET_ACCESS_KEY="REPLACE_WITH_B2_APPLICATION_KEY"
export TG_STATE_BUCKET="maagaparuga-tfstate"                           # create this bucket in B2
export TG_STATE_ENDPOINT="https://s3.eu-central-003.backblazeb2.com" # your bucket's S3 endpoint
export TG_STATE_REGION="eu-central-003"                              # matches the endpoint

# (Alternative: use DigitalOcean Spaces for state instead of B2 — same AWS_* vars,
#  set TG_STATE_ENDPOINT=https://<region>.digitaloceanspaces.com and the Spaces key.)
