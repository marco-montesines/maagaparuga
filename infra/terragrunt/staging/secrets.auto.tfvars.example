# Copy to `secrets.auto.tfvars` (gitignored) and fill in, OR export as env vars.
# Ideally a SEPARATE Hetzner project/token from production.
#
#   export HCLOUD_TOKEN=...        # staging project token
#   export TF_VAR_admin_allowed_ips='["203.0.113.4/32"]'

hcloud_token      = "REPLACE_WITH_STAGING_PROJECT_HETZNER_TOKEN"
admin_allowed_ips = ["203.0.113.4/32"] # your admin IP(s); `curl -s https://ifconfig.me`
ssh_public_keys   = ["ssh-ed25519 AAAA... you@host"]

# k8s_api_allowed_ips = []   # optional; empty keeps 6443 closed
